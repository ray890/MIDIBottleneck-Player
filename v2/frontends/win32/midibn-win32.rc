            VALUE "ProductName", "MIDIBottleneck Player"
            VALUE "ProductVersion", "2.0.0.0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Ray890"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
